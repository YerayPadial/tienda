# Habilitar rewrite engine
RewriteEngine On

# Configurar la base para el subdirectorio del admin
RewriteBase /panelTienda/

# Headers de seguridad reforzados para panel administrativo
<IfModule mod_headers.c>
    # Prevenir clickjacking - MÁS restrictivo para admin
    Header always set X-Frame-Options DENY
    
    # Prevenir MIME type sniffing
    Header always set X-Content-Type-Options nosniff
    
    # Habilitar XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy más restrictivo para admin
    Header always set Referrer-Policy "strict-origin"
    
    # Content Security Policy específico para panel administrativo
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' http://localhost:8000 https://localhost:8000; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
    
    # Strict Transport Security (para HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Permissions Policy más restrictivo para admin
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), autoplay=(), fullscreen=()"
    
    # Headers adicionales para seguridad administrativa
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache para recursos estáticos
<IfModule mod_expires.c>
    ExpiresActive on
    
    # Assets estáticos (imágenes, fonts, etc.)
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # CSS y JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # HTML
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Configuración para archivos estáticos con hash (Vite)
<IfModule mod_rewrite.c>
    # Archivos con hash pueden tener cache largo
    RewriteCond %{REQUEST_FILENAME} \.(css|js)$
    RewriteCond %{REQUEST_FILENAME} -[a-f0-9]{8}\.(css|js)$
    RewriteRule .* - [E=CACHE:1]
</IfModule>

<IfModule mod_headers.c>
    # Cache largo para archivos con hash
    Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE
</IfModule>

# Reglas de rewrite para React Router (Panel Administrativo)
<IfModule mod_rewrite.c>
    # Manejar archivos estáticos normalmente
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule .* - [L]
    
    # Manejar directorios normalmente
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]
    
    # Para todas las demás rutas del admin, servir index.html (React Router)
    RewriteCond %{REQUEST_URI} !^/panelTienda/assets/
    RewriteCond %{REQUEST_URI} !^/panelTienda/vite\.svg$
    RewriteCond %{REQUEST_URI} !^/panelTienda/favicon\.ico$
    RewriteRule ^(.*)$ /panelTienda/index.html [L,QSA]
</IfModule>

# Bloquear acceso a archivos sensibles (más estricto para admin)
<FilesMatch "\.(env|git|htaccess|htpasswd|ini|log|sh|inc|bak|sql|config|json|ts|tsx)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a directorios de desarrollo y código fuente
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/panelTienda/(node_modules|src|\.git|\.vscode|dist)/
    RewriteRule .* - [R=404,L]
</IfModule>

# Protección adicional para panel administrativo
<IfModule mod_rewrite.c>
    # Bloquear bots y crawlers en el admin
    RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider|scraper) [NC]
    RewriteRule ^(.*)$ - [R=403,L]
    
    # Limitar acceso solo a ciertos métodos HTTP
    RewriteCond %{REQUEST_METHOD} !^(GET|POST|PUT|DELETE|OPTIONS)$
    RewriteRule .* - [R=405,L]
</IfModule>

# Configuración para SPA Admin - Headers adicionales
<IfModule mod_headers.c>
    # Cache busting para index.html del admin
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
        # Header adicional para admin
        Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    </FilesMatch>
    
    # Headers específicos para archivos de admin
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "private, max-age=86400"
    </FilesMatch>
</IfModule>

# Bloquear indexación de motores de búsqueda para admin
<Files "robots.txt">
    Header set Content-Type "text/plain"
</Files>

# Crear robots.txt virtual para bloquear indexación
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/panelTienda/robots\.txt$
    RewriteRule ^(.*)$ - [E=ROBOTS:1]
</IfModule>

<IfModule mod_headers.c>
    Header always set Content-Type "text/plain" env=ROBOTS
    Header always set Content-Length "26" env=ROBOTS
</IfModule>

# Rate limiting básico para admin (prevenir ataques de fuerza bruta)
<IfModule mod_evasive24.c>
    DOSHashTableSize    2048
    DOSPageCount        10
    DOSPageInterval     1
    DOSBlockingPeriod   600
    DOSEmailNotify      admin@yourdomain.com
</IfModule>

# Configuración MIME types adicionales
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/json .json
    AddType application/manifest+json .webmanifest
</IfModule>

# Configuración para PWA 
<IfModule mod_rewrite.c>
    # Service Worker
    RewriteCond %{REQUEST_URI} sw\.js$
    RewriteRule .* - [E=SW:1]
</IfModule>

<IfModule mod_headers.c>
    # Headers específicos para Service Worker
    Header set Service-Worker-Allowed "/" env=SW
    Header set Cache-Control "no-cache" env=SW
</IfModule>

